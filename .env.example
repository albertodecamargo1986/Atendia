# =============================================================================
# AtendIA — Configuração de PRODUÇÃO (arquivo /opt/atendia/.env)
#
# Você normalmente NÃO precisa criar este arquivo à mão: o instalador
# (install/install.sh) gera tudo sozinho, com senhas fortes aleatórias.
# Para mudar algo depois, prefira:   sudo atendia config
#
# Se editar à mão:
#   - use só letras e números nas senhas (elas entram em URLs de conexão);
#   - NUNCA troque SESSION_ENCRYPTION_KEY depois de conectar o WhatsApp
#     (as sessões salvas deixam de abrir e será preciso ler o QR de novo);
#   - depois de salvar:  cd /opt/atendia && docker compose up -d
#
# Desenvolvimento local usa packages/backend/.env (ver docker-compose.dev.yml).
# =============================================================================

# ---------------------------------------------------------------------------
# Endereço público do sistema (como as pessoas acessam no navegador)
#   Só IP (teste):   http://34.123.45.67
#   Com domínio:     https://minhaempresa.duckdns.org
# FRONTEND_URL, ALLOWED_ORIGINS e API_URL são derivados daqui automaticamente.
# O cookie "seguro" (COOKIE_SECURE) liga sozinho quando o endereço começa com https.
# ---------------------------------------------------------------------------
PUBLIC_URL=http://SEU_IP_AQUI

# Endereço que o servidor web (Caddy) atende:
#   ":80"                      -> só IP, sem HTTPS
#   "minhaempresa.duckdns.org" -> domínio com HTTPS automático (Let's Encrypt)
SITE_ADDRESS=:80
# E-mail para o certificado HTTPS (avisos de expiração)
ACME_EMAIL=voce@exemplo.com

# ---------------------------------------------------------------------------
# Segredos (OBRIGATÓRIOS). Gere com:  openssl rand -hex 32  (senhas: -hex 24)
# ---------------------------------------------------------------------------
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
# 64 caracteres hexadecimais (openssl rand -hex 32)
SESSION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Inteligência Artificial (opcional — também dá para cadastrar no painel)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# E-mail de saída / SMTP (opcional — recuperação de senha, avisos)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#        SMTP_PASS = "senha de app" (não é a senha normal da conta)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AtendIA <noreply@atendia.local>"

# ---------------------------------------------------------------------------
# Pagamentos (opcional)
# Mercado Pago: URL de webhook a cadastrar no painel do MP:
#   <PUBLIC_URL>/api/payments/webhook/mercadopago
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=false
# Token de teste (TEST-...) usado no lugar de MP_ACCESS_TOKEN quando MP_SANDBOX=true
MP_SANDBOX_TOKEN=
# Stripe: webhook em <PUBLIC_URL>/api/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Avançado (normalmente não mexer)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
MAX_FILE_SIZE=10485760
# Versão das imagens (latest = mais recente da branch main; ou sha-xxxxxxx)
ATENDIA_VERSION=latest
# Imagem do Postgres. Use postgres:15 se reaproveitar volume antigo da imagem pgvector.
# POSTGRES_IMAGE=postgres:15-alpine
# Compilar as imagens no próprio servidor (precisa de ~2,5 GB RAM+swap):
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
# Forçar cookie seguro (true/false). Vazio = automático pelo PUBLIC_URL.
# COOKIE_SECURE=
