# syntax=docker/dockerfile:1.7
# =============================================================================
# AtendIA — Imagens de PRODUÇÃO (multi-stage)
#
#   Backend (API + WhatsApp + filas):
#     docker build -f Dockerfile.prod --target backend -t atendia-backend .
#   Web (Caddy servindo o painel + proxy para o backend):
#     docker build -f Dockerfile.prod --target web -t atendia-web .
#
# As imagens oficiais são geradas pelo GitHub Actions (.github/workflows/deploy.yml)
# e publicadas em ghcr.io/albertodecamargo1986/atendia-{backend,web} para
# linux/amd64 e linux/arm64. Uma VPS de 1 GB NÃO deve compilar: só faz "pull".
# =============================================================================

ARG NODE_IMAGE=node:22-alpine
ARG CADDY_IMAGE=caddy:2-alpine

# -----------------------------------------------------------------------------
# base: ferramentas de compilação (só nos estágios de build, nunca no runtime)
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS base
RUN apk add --no-cache git openssl python3 make g++ \
 && git config --global url."https://github.com/".insteadOf "ssh://git@github.com/" \
 && git config --global --add url."https://github.com/".insteadOf "git@github.com:"
WORKDIR /app
ENV CI=true \
    HUSKY=0 \
    PRISMA_HIDE_UPDATE_MESSAGE=1 \
    CHECKPOINT_DISABLE=1 \
    npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false
# Só os manifests: a camada de dependências fica em cache enquanto eles não mudarem
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/backend/package.json packages/backend/
COPY packages/frontend/package.json packages/frontend/

# -----------------------------------------------------------------------------
# deps: todas as dependências (inclui devDependencies para compilar)
# -----------------------------------------------------------------------------
FROM base AS deps
RUN --mount=type=cache,target=/root/.npm npm ci

# -----------------------------------------------------------------------------
# prod-deps: só dependências de produção do backend + shared (sem frontend)
# -----------------------------------------------------------------------------
FROM base AS prod-deps
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --workspace=backend --workspace=atend-ia-shared \
 && mkdir -p packages/backend/node_modules packages/shared/node_modules

# -----------------------------------------------------------------------------
# shared: compila o pacote compartilhado
# -----------------------------------------------------------------------------
FROM deps AS shared-build
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
RUN npm run build -w atend-ia-shared

# -----------------------------------------------------------------------------
# backend-build: prisma generate + tsc
# -----------------------------------------------------------------------------
FROM shared-build AS backend-build
COPY packages/backend/ packages/backend/
WORKDIR /app/packages/backend
RUN npx prisma generate --schema=prisma/schema.prisma \
 && npm run build \
 && test -f dist/index.js

# -----------------------------------------------------------------------------
# frontend-build: vite build (VITE_API_URL vazio => usa "/api" do mesmo domínio)
# -----------------------------------------------------------------------------
FROM shared-build AS frontend-build
ARG VITE_API_URL=""
ARG VITE_WS_URL=""
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_WS_URL=${VITE_WS_URL}
COPY packages/frontend/ packages/frontend/
RUN npm run build -w frontend && test -f packages/frontend/dist/index.html

# -----------------------------------------------------------------------------
# backend-release: monta a árvore final (prod deps + dist + prisma client + CLI)
# -----------------------------------------------------------------------------
FROM prod-deps AS backend-release
# Pacote shared compilado (o node_modules/atend-ia-shared é um link para cá)
COPY --from=shared-build /app/packages/shared/package.json packages/shared/package.json
COPY --from=shared-build /app/packages/shared/dist packages/shared/dist
# Backend compilado + schema/migrations
COPY --from=backend-build /app/packages/backend/package.json packages/backend/package.json
COPY --from=backend-build /app/packages/backend/dist packages/backend/dist
COPY --from=backend-build /app/packages/backend/prisma packages/backend/prisma
# Prisma: client gerado + CLI (necessária para "migrate deploy" no start)
COPY --from=backend-build /app/node_modules/.prisma node_modules/.prisma
COPY --from=backend-build /app/node_modules/@prisma node_modules/@prisma
COPY --from=backend-build /app/node_modules/prisma node_modules/prisma
RUN mkdir -p node_modules/.bin \
 && ln -sf ../prisma/build/index.js node_modules/.bin/prisma \
 && rm -rf packages/backend/dist/__tests__ \
 && find packages/backend/dist -name '*.map' -delete

# -----------------------------------------------------------------------------
# TARGET: backend
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS backend
RUN apk add --no-cache openssl tini \
 && addgroup -S app && adduser -S -G app -h /home/app app
ENV NODE_ENV=production \
    PORT=3001 \
    WHATSAPP_AUTH_DIR=/app/data/whatsapp-auth \
    UPLOAD_DIR=/app/data/uploads \
    PRISMA_HIDE_UPDATE_MESSAGE=1 \
    CHECKPOINT_DISABLE=1 \
    npm_config_update_notifier=false \
    PATH=/app/node_modules/.bin:$PATH
COPY --from=backend-release /app /app
# Pasta de dados (WhatsApp + uploads) pertence ao usuário "app".
# Um volume nomeado montado em /app/data herda esse dono na primeira vez.
RUN mkdir -p /app/data/whatsapp-auth /app/data/uploads \
 && chown -R app:app /app/data
WORKDIR /app/packages/backend
USER app
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3001/health >/dev/null 2>&1 || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
# Migrations rodam em todo start. Se falharem, o container NÃO sobe (sem engolir erro).
CMD ["sh", "-c", "prisma migrate deploy --schema=prisma/schema.prisma && exec node dist/index.js"]

# -----------------------------------------------------------------------------
# TARGET: web (Caddy: painel estático + proxy /api, /socket.io, /uploads)
# -----------------------------------------------------------------------------
FROM ${CADDY_IMAGE} AS web
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-build /app/packages/frontend/dist /srv
RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
EXPOSE 80 443 443/udp
