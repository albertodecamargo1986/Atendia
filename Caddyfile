# =============================================================================
# AtendIA — Caddy (servidor web de produção)
#
# SITE_ADDRESS (no /opt/atendia/.env):
#   ":80"                  -> acesso só pelo IP, em HTTP (padrão, para testes)
#   "atendia.duckdns.org"  -> domínio com HTTPS automático (Let's Encrypt)
# ACME_EMAIL: e-mail usado no certificado HTTPS (avisos de expiração).
#
# Rotas do backend (sem remover prefixo): /api/*, /socket.io/*, /uploads/*,
# /health (/ready só interno). Todo o resto é o painel (SPA -> index.html).
# =============================================================================
{
	email {$ACME_EMAIL:admin@atendia.local}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	request_body {
		max_size 20MB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
		-Via
	}

	# /ready expõe o estado interno de banco/Redis: só para uso interno (healthcheck).
	handle /ready {
		respond 404
	}

	@backend path /api/* /socket.io/* /uploads/* /health
	handle @backend {
		# WebSocket (Socket.IO) e cabeçalhos X-Forwarded-* são tratados automaticamente
		reverse_proxy backend:3001
	}

	handle {
		root * /srv

		# Arquivos com hash do Vite: cache de 1 ano
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html e demais: sempre revalidar (para atualizações aparecerem na hora)
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# CSP do painel (tudo é servido pelo próprio domínio; sem scripts inline)
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

		try_files {path} /index.html
		file_server
	}
}
