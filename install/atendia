cmd_config() {
  need_tty
  local choice
  while :; do
    choice=$(ask_menu "AtendIA — Configurações" "Endereço atual: $(public_url)\n\nO que deseja configurar?" \
      dominio  "Domínio + HTTPS (cadeado)" \
      ip       "Voltar a usar só o IP (sem domínio)" \
      ia       "Chaves de IA (OpenAI / Anthropic)" \
      smtp     "E-mail de envio (SMTP)" \
      mp       "Mercado Pago (pagamentos)" \
      senha    "Trocar senha do administrador" \
      info     "Ver endereço e dados de acesso") || break
    case "$choice" in
      dominio) config_domain ;;
      ip)      config_ip_only ;;
      ia)      config_ai ;;
      smtp)    config_smtp ;;
      mp)      config_mp ;;
      senha)   cmd_senha_admin ;;
      info)    cmd_info; [[ "$USE_WHIPTAIL" == 1 ]] && { printf 'Enter para voltar ao menu...'; IFS= read -r _ </dev/tty || true; } ;;
      *) break ;;
    esac
  done
}

cmd_desinstalar() {
  need_tty
  ask_yesno "Desinstalar o AtendIA" "Isso vai PARAR e APAGAR o AtendIA deste servidor:\nbanco de dados, conversas, sessões do WhatsApp e arquivos.\n\nUm backup final será feito e os backups serão movidos para\n/root/atendia-backups (NÃO são apagados).\n\nDeseja continuar?" || die "Cancelado."
  local answer
  answer=$(ask_input "Confirmação final" "Digite DESINSTALAR (em maiúsculas) para confirmar:" "") || die "Cancelado."
  [[ "$answer" == "DESINSTALAR" ]] || die "Cancelado (não digitou DESINSTALAR)."

  info "Backup final..."
  cmd_backup --auto || warn "Backup final falhou."
  mkdir -p /root/atendia-backups
  cp -p "$BACKUP_DIR"/atendia-backup-*.tar /root/atendia-backups/ 2>/dev/null || true
  cp -p "$ENV_FILE" /root/atendia-backups/config-final.env 2>/dev/null || true
  chmod -R go-rwx /root/atendia-backups

  info "Removendo containers, volumes e imagens..."
  compose down -v --rmi all --remove-orphans || true
  rm -f /etc/cron.d/atendia /etc/logrotate.d/atendia
  rm -rf "$ATENDIA_DIR"
  rm -f "$CLI_PATH"
  ok "AtendIA removido. Backups guardados em /root/atendia-backups"
  info "Docker e o swap continuam instalados (podem ser usados por outros programas)."
}

# ----------------------------------------------------------------------------
main() {
  local cmd=${1:-help}
  shift || true
  case "$cmd" in
    help|-h|--help|ajuda) cmd_help; return 0 ;;
  esac
  require_root "$cmd"
  require_install
  case "$cmd" in
    status)                 cmd_status ;;
    info)                   cmd_info ;;
    logs|log)               cmd_logs "$@" ;;
    restart|reiniciar)      cmd_restart "$@" ;;
    stop|parar)             cmd_stop ;;
    start|iniciar)          cmd_start ;;
    update|atualizar)       cmd_update ;;
    backup)                 cmd_backup "$@" ;;
    restore|restaurar)      cmd_restore "$@" ;;
    config|configurar)      cmd_config ;;
    dominio|domain)         need_tty; config_domain ;;
    senha-admin|senha)      cmd_senha_admin ;;
    desinstalar|uninstall)  cmd_desinstalar ;;
    *) fail "Comando desconhecido: ${cmd}"; cmd_help; exit 1 ;;
  esac
}

# "exit" na mesma linha: o bash não lê mais nada do arquivo depois (seguro durante o update)
main "$@"; exit $?
