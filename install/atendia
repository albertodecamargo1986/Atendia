  ${C_BOLD}sudo atendia stop${C_RESET}              parar o sistema
  ${C_BOLD}sudo atendia start${C_RESET}             iniciar o sistema
  ${C_BOLD}sudo atendia update${C_RESET}            atualizar para a versão mais nova (faz backup antes)
  ${C_BOLD}sudo atendia backup${C_RESET}            fazer um backup agora (mantém os ${BACKUP_KEEP} mais recentes)
