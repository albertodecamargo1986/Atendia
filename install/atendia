cmd_info() {
  local url
  url=$(public_url)
  printf '\n  %s %s\n' "${C_BOLD}Endereço:${C_RESET}" "${C_CYAN}${url}${C_RESET}"
  printf '  %s %s\n' "${C_BOLD}Administrador:${C_RESET}" "$(env_get ATENDIA_ADMIN_EMAIL)"
  printf '  %s %s\n' "${C_BOLD}Credenciais:${C_RESET}" "${CRED_FILE}  (ver: sudo cat ${CRED_FILE})"
  printf '  %s %s\n' "${C_BOLD}Configuração:${C_RESET}" "$ENV_FILE"
  printf '  %s %s\n' "${C_BOLD}Backups:${C_RESET}" "$BACKUP_DIR"
  printf '  %s %s\n' "${C_BOLD}Versão:${C_RESET}" "$(git -C "$ATENDIA_DIR" log -1 --format='%h (%cd)' --date=format:'%d/%m/%Y' 2>/dev/null || echo '?')"
  printf '  %s %s\n\n' "${C_BOLD}Webhook Mercado Pago:${C_RESET}" "${url}/api/payments/webhook/mercadopago"
}

cmd_status() {
  local url status code
  url=$(public_url)
  printf '\n%s\n' "${C_BOLD}Serviços${C_RESET}"
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}' 2>/dev/null || compose ps
  printf '\n%s\n' "${C_BOLD}Uso de memória/CPU${C_RESET}"
  local ids
  ids=$(compose ps -q 2>/dev/null || true)
  if [[ -n "$ids" ]]; then
    # shellcheck disable=SC2086
    docker stats --no-stream --format 'table {{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}' $ids || true
  fi
  printf '\n%s\n' "${C_BOLD}Servidor${C_RESET}"
  free -m | awk 'NR==1 {print "              total   usado   livre"} /^Mem:/ {printf "  RAM (MB):   %6s  %6s  %6s\n", $2, $3, $7} /^Swap:/ {printf "  Swap (MB):  %6s  %6s  %6s\n", $2, $3, $4}'
  df -h / | awk 'NR==2 {printf "  Disco:      %s usados de %s (%s livres)\n", $3, $2, $4}'

  status=$(backend_health)
  code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' http://127.0.0.1/health 2>/dev/null || true)
  printf '\n%s\n' "${C_BOLD}Situação${C_RESET}"
  if [[ "$status" == healthy ]]; then ok "Sistema: funcionando"; else warn "Sistema: ${status}"; fi
  case "$code" in
    200) ok "Servidor web: respondendo" ;;
    301|302|308) ok "Servidor web: respondendo (redireciona para HTTPS)" ;;
    *) warn "Servidor web: sem resposta (${code:-nenhuma}) — veja: sudo atendia logs web" ;;
  esac
  printf '  Endereço: %s\n\n' "${C_CYAN}${url}${C_RESET}"
}

cmd_logs() {
  local svc=${1:-backend}
  case "$svc" in
    todos|all|tudo) compose logs -f --tail=100 ;;
    api|sistema|app) compose logs -f --tail=100 backend ;;
    banco|db) compose logs -f --tail=100 postgres ;;
    site|caddy) compose logs -f --tail=100 web ;;
    fila) compose logs -f --tail=100 redis ;;
    *) compose logs -f --tail=100 "$svc" ;;
  esac
}

cmd_restart() {
  if [[ -n "${1:-}" ]]; then
    compose restart "$1"
  else
    compose restart
  fi
  ok "Reiniciado."
  wait_healthy 240 || true
}

cmd_stop()  { compose stop; ok "Sistema parado. Para voltar: sudo atendia start"; }
cmd_start() { compose up -d; wait_healthy 240 || true; cmd_info; }

install_self() {
  # Troca atômica (novo arquivo + mv): o script em execução não é corrompido
  if [[ -f "$ATENDIA_DIR/install/atendia" ]]; then
    install -m 755 "$ATENDIA_DIR/install/atendia" "${CLI_PATH}.new"
    mv -f "${CLI_PATH}.new" "$CLI_PATH"
  fi
}

# Hash do conteúdo de um arquivo (vazio se não der para ler)
file_hash() { sha256sum -- "$1" 2>/dev/null | cut -d' ' -f1 || true; }

cmd_update() {
  # --apos-atualizar-script: uso INTERNO. É a versão nova deste comando, chamada
  # pela versão anterior logo depois de baixar o código: pula backup e download
  # (já feitos) e nunca reexecuta de novo (sem loop).
  if [[ "${1:-}" == "--apos-atualizar-script" || "${ATENDIA_UPDATE_REEXEC:-}" == 1 ]]; then
    unset ATENDIA_UPDATE_REEXEC
    ok "Comando atendia atualizado; continuando a atualização com a versão nova."
    update_finish
    return
  fi

  # Hash do script EM EXECUÇÃO, antes de o código novo substituir qualquer arquivo
  local self_hash new_hash
  self_hash=$(file_hash "${BASH_SOURCE[0]}")

  info "Fazendo backup antes de atualizar..."
  cmd_backup --auto || warn "Backup falhou — continuando a atualização mesmo assim."

  info "Baixando a versão mais nova do código..."
  local branch
  branch=$(git -C "$ATENDIA_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
  [[ "$branch" == HEAD ]] && branch=main
  git -C "$ATENDIA_DIR" fetch --depth 1 origin "$branch" >/dev/null
  if [[ -n "$(git -C "$ATENDIA_DIR" status --porcelain --untracked-files=no)" ]]; then
    local patch
    patch="$BACKUP_DIR/alteracoes-locais-$(date +%Y%m%d-%H%M%S).patch"
    git -C "$ATENDIA_DIR" diff > "$patch" || true
    warn "Havia arquivos editados à mão; cópia das alterações em ${patch}"
  fi
  git -C "$ATENDIA_DIR" reset --hard FETCH_HEAD >/dev/null
  ok "Código atualizado: $(git -C "$ATENDIA_DIR" log -1 --format='%h %s')"
  install_self

  # O comando atendia mudou? Continua com a versão NOVA nesta mesma execução:
  # o que ela prepara (pasta de controle, cron...) já vale agora.
  new_hash=$(file_hash "$ATENDIA_DIR/install/atendia")
  if [[ -n "$new_hash" && "$new_hash" != "$self_hash" && "$(file_hash "$CLI_PATH")" == "$new_hash" ]]; then
    info "O comando atendia tem versão nova; continuando com ela..."
    export ATENDIA_UPDATE_REEXEC=1
    exec "$CLI_PATH" update --apos-atualizar-script
  fi
  update_finish
}

# Segunda metade do update (sempre executada pela versão mais nova do comando)
update_finish() {
  # Pasta de controle + cron + SERVER_PUBLIC_IP (troca de domínio pelo painel)
  ensure_domain_infra

  if [[ "$(env_get COMPOSE_FILE)" == *build* ]]; then
    info "Compilando as imagens no servidor (pode demorar bastante)..."
    compose pull --quiet --ignore-buildable 2>/dev/null || true
    compose build
  else
    info "Baixando imagens novas..."
    compose pull --quiet
  fi
  compose up -d --remove-orphans
  docker image prune -f >/dev/null 2>&1 || true
  wait_healthy 300
  ok "Atualização concluída."
}

cmd_backup() {
  local auto=0
  [[ "${1:-}" == "--auto" ]] && auto=1
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"

  local free_mb
  free_mb=$(df -Pm "$BACKUP_DIR" | awk 'NR==2 {print $4}')
  if (( free_mb < 500 )); then
    die "Pouco espaço em disco (${free_mb} MB livres). Apague backups antigos em ${BACKUP_DIR}."
  fi

  local ts work final
  ts=$(date +%Y%m%d-%H%M%S)
  work=$(mktemp -d "$BACKUP_DIR/.tmp-${ts}-XXXX")
  CLEANUP+=("$work")
  final="$BACKUP_DIR/atendia-backup-${ts}.tar"

  [[ $auto == 1 ]] && printf '[%s] ' "$(date '+%d/%m/%Y %H:%M:%S')"
  info "Copiando o banco de dados..."
  compose exec -T postgres pg_dump -U atend -d atend_ia --no-owner --no-privileges | gzip -6 > "$work/banco.sql.gz"
  gzip -t "$work/banco.sql.gz"

  info "Copiando arquivos (WhatsApp e anexos)..."
  compose run --rm --no-deps -T --entrypoint tar backend \
    czf - -C /app/data --exclude='./tmp' --exclude='*.tmp' --exclude='*.part' . > "$work/arquivos.tar.gz"

  cp -p "$ENV_FILE" "$work/config.env"
  {
    printf 'AtendIA backup %s\n' "$ts"
    printf 'Versão: %s\n' "$(git -C "$ATENDIA_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
    printf 'Endereço: %s\n' "$(public_url)"
  } > "$work/info.txt"

  tar cf "$final" -C "$work" banco.sql.gz arquivos.tar.gz config.env info.txt
  chmod 600 "$final"
  rm -rf "$work"

  # Mantém só os N mais recentes
  local old
  while IFS= read -r old; do
    [[ -n "$old" ]] && rm -f -- "$old"
  done < <(find "$BACKUP_DIR" -maxdepth 1 -name 'atendia-backup-*.tar' -printf '%T@ %p\n' | sort -rn | awk -v k="$BACKUP_KEEP" 'NR > k {print $2}')

  ok "Backup salvo: ${final} ($(du -h "$final" | cut -f1))"
  if [[ $auto == 0 ]]; then
    info "Dica: copie os backups para fora do servidor de vez em quando (ex.: scp ou Google Drive)."
  fi
}

list_backups() {
  printf '\n  Backups disponíveis em %s:\n' "$BACKUP_DIR"
  find "$BACKUP_DIR" -maxdepth 1 -name 'atendia-backup-*.tar' -printf '    %f  (%TY-%Tm-%Td %TH:%TM, %s bytes)\n' 2>/dev/null | sort -r || true
  printf '\n  Uso: sudo atendia restore <arquivo>\n\n'
}

cmd_restore() {
  local file=${1:-}
  if [[ -z "$file" ]]; then list_backups; return 0; fi
  [[ -f "$file" ]] || file="$BACKUP_DIR/$file"
  [[ -f "$file" ]] || die "Arquivo não encontrado: ${1}"

  local work
  work=$(mktemp -d)
  CLEANUP+=("$work")
  tar xf "$file" -C "$work" || die "Arquivo de backup inválido ou corrompido."
  [[ -f "$work/banco.sql.gz" ]] || die "Este arquivo não parece um backup do AtendIA (falta banco.sql.gz)."
  gzip -t "$work/banco.sql.gz" || die "O banco dentro do backup está corrompido."

  need_tty
  printf '\n%s\n' "${C_YELLOW}${C_BOLD}ATENÇÃO:${C_RESET}${C_YELLOW} restaurar APAGA os dados atuais e volta tudo para o backup:${C_RESET}"
  sed 's/^/    /' "$work/info.txt" 2>/dev/null || true
  local answer
  answer=$(ask_input "Confirmar restauração" "Isso vai SUBSTITUIR todos os dados atuais pelos do backup.\n(Um backup de segurança do estado atual será feito antes.)\n\nDigite RESTAURAR para confirmar:" "") || die "Cancelado."
  [[ "$answer" == "RESTAURAR" ]] || die "Cancelado (não digitou RESTAURAR)."

  info "Backup de segurança do estado atual..."
  cmd_backup --auto || die "Não consegui fazer o backup de segurança; restauração cancelada."

  info "Parando o sistema..."
  compose stop backend web >/dev/null 2>&1 || true
  compose up -d postgres redis >/dev/null

  info "Restaurando o banco de dados..."
  compose exec -T postgres psql -U atend -d postgres -v ON_ERROR_STOP=1 -q \
    -c 'DROP DATABASE IF EXISTS atend_ia WITH (FORCE);' -c 'CREATE DATABASE atend_ia OWNER atend;' >/dev/null
  gunzip -c "$work/banco.sql.gz" | compose exec -T postgres psql -U atend -d atend_ia -v ON_ERROR_STOP=1 -q >/dev/null
  ok "Banco restaurado."

  if [[ -s "$work/arquivos.tar.gz" ]]; then
    info "Restaurando arquivos (WhatsApp e anexos)..."
    compose run --rm --no-deps -T --entrypoint sh backend \
      -c 'find /app/data -mindepth 1 -delete && tar xzf - -C /app/data' < "$work/arquivos.tar.gz"
    ok "Arquivos restaurados."
  fi

  if ! cmp -s "$work/config.env" "$ENV_FILE" 2>/dev/null; then
    warn "A configuração (.env) do backup é diferente da atual e NÃO foi alterada."
    warn "Se o servidor é novo, as chaves antigas estão em: tar xf ${file} config.env"
  fi

  compose up -d
  wait_healthy 300 || true
  ok "Restauração concluída."
}

run_create_admin() {
  # run_create_admin EMAIL SENHA [--reset-password]
  local email=$1 pw=$2 flag=${3:-} company
  company=$(env_get ATENDIA_COMPANY_NAME)
  compose exec -T backend test -f dist/scripts/create-admin.js \
    || die "Script create-admin não encontrado nesta versão. Atualize: sudo atendia update"
  (cd "$ATENDIA_DIR" && ADMIN_EMAIL="$email" ADMIN_PASSWORD="$pw" COMPANY_NAME="${company:-Minha Empresa}" ADMIN_NAME="Administrador" \
    docker compose exec -T -e ADMIN_EMAIL -e ADMIN_PASSWORD -e COMPANY_NAME -e ADMIN_NAME \
    backend node dist/scripts/create-admin.js ${flag:+"$flag"})
}

cmd_senha_admin() {
  need_tty
  local email pw p2 generated=0
  email=$(ask_input "Trocar senha do administrador" "E-mail do administrador:" "$(env_get ATENDIA_ADMIN_EMAIL)") || die "Cancelado."
  email=$(printf '%s' "$email" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  valid_email "$email" || die "E-mail inválido."
  while :; do
    pw=$(ask_password "Nova senha" "Nova senha (8+ caracteres, com maiúscula, minúscula e número).\n\nAperte Enter para GERAR uma senha forte automaticamente.") || die "Cancelado."
    if [[ -z "$pw" ]]; then pw=$(gen_password); generated=1; break; fi
    if ! password_ok "$pw"; then show_msg "Senha fraca" "Use 8+ caracteres, com maiúscula, minúscula e número (sem aspas simples)."; continue; fi
    p2=$(ask_password "Nova senha" "Digite a mesma senha de novo:") || die "Cancelado."
    [[ "$pw" == "$p2" ]] && break
    show_msg "Senhas diferentes" "As senhas não conferem. Tente de novo."
  done
  run_create_admin "$email" "$pw" --reset-password
  if [[ "$email" == "$(env_get ATENDIA_ADMIN_EMAIL)" ]]; then
    update_cred_file "Senha" "$pw"
  fi
  ok "Senha alterada para ${email}."
  if [[ $generated == 1 ]]; then
    printf '\n  %s %s\n  %s\n\n' "${C_BOLD}Nova senha:${C_RESET}" "$pw" "(anote! também salva em ${CRED_FILE})" >/dev/tty
  fi
}

# --- domínio + HTTPS ---------------------------------------------------------
# Lógica ÚNICA usada pelo menu (atendia config > Domínio), pelo comando manual
# (atendia dominio <dominio> [email]) e pelos pedidos do painel
# (atendia aplicar-dominio-pendente, chamado pelo cron a cada minuto).

# IP público deste servidor (SERVER_PUBLIC_IP do .env; senão detecta)
server_ip() {
  local ip
  ip=$(env_get SERVER_PUBLIC_IP)
  valid_ipv4 "${ip:-x}" || ip=$(detect_public_ip)
  printf '%s' "$ip"
}

# IPv4 para os quais o domínio aponta (ordenados, separados por espaço)
domain_ips() {
  local d=$1 out
  out=$(getent ahostsv4 "$d" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' || true)
  if [[ -z "${out// /}" ]] && command -v dig >/dev/null 2>&1; then
    out=$(dig +short A "$d" 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+){3}$' | sort -u | tr '\n' ' ' || true)
  fi
  printf '%s' "${out% }"
}

# OK só se houver ao menos um IP e TODOS forem o do servidor (mesma regra do painel)
dns_points_here() {
  local ips=$1 ip=$2 x list=()
  [[ -n "$ips" && -n "$ip" ]] || return 1
  read -r -a list <<< "$ips"
  (( ${#list[@]} > 0 )) || return 1
  for x in "${list[@]}"; do [[ "$x" == "$ip" ]] || return 1; done
  return 0
}

# Código HTTP de https://DOMINIO/health, falando direto com o Caddy deste
# servidor (127.0.0.1) mas validando o certificado do domínio.
https_health_code() {
  curl -s -o /dev/null -m 10 -w '%{http_code}' --resolve "${1}:443:127.0.0.1" "https://${1}/health" 2>/dev/null || true
}

json_escape() {
  local s=${1:-}
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\n'/ }; s=${s//$'\r'/ }; s=${s//$'\t'/ }
  printf '%s' "$s"
}

# write_domain_status ESTADO MENSAGEM [DOMINIO]   (ESTADO: applied | error | pending)
# Lido pelo painel em /app/control/domain-status.json. Gravação atômica.
write_domain_status() {
  local state=$1 msg=$2 domain=${3:-} tmp dom_json
  [[ -d "$CONTROL_DIR" && ! -L "$CONTROL_DIR" ]] || return 0
  dom_json=null
  [[ -n "$domain" ]] && dom_json="\"$(json_escape "$domain")\""
  tmp=$(mktemp "$CONTROL_DIR/.domain-status.XXXXXX")
  printf '{\n  "state": "%s",\n  "message": "%s",\n  "domain": %s,\n  "appliedAt": "%s"\n}\n' \
    "$state" "$(json_escape "$msg")" "$dom_json" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$DOMAIN_STATUS_FILE"
}

# Lê um campo TEXTO do JSON do pedido. Nada do arquivo é executado: o valor só
# é usado depois de passar por valid_domain_strict / valid_email_strict.
read_json_field() {
  local file=$1 key=$2
  if command -v jq >/dev/null 2>&1; then
    jq -j --arg k "$key" 'if type == "object" and (.[$k] | type) == "string" then .[$k] else empty end' "$file" 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
try:
    v = json.load(open(sys.argv[1], encoding="utf-8")).get(sys.argv[2])
except Exception:
    v = None
if isinstance(v, str):
    sys.stdout.write(v)
' "$file" "$key" 2>/dev/null || true
  else
    # Sem jq/python: aceita só o formato que o backend grava ("chave": "valor" numa linha)
    sed -n "s/^[[:space:]]*\"${key}\"[[:space:]]*:[[:space:]]*\"\([A-Za-z0-9._+@-]*\)\"[[:space:]]*,\{0,1\}[[:space:]]*\$/\1/p" "$file" 2>/dev/null \
      | head -n 1 | tr -d '\n' || true
  fi
}

# Trava para nunca rodar duas trocas de domínio ao mesmo tempo
take_domain_lock() {
  local lf=$DOMAIN_LOCK_FILE
  command -v flock >/dev/null 2>&1 || return 0
  [[ -d "${lf%/*}" ]] || lf="$ATENDIA_DIR/.domain.lock"
  exec 9>"$lf"
  flock -n 9
}

# Aplica o domínio (.env + recria web e backend) e espera o HTTPS responder.
# 0 = HTTPS ativo; 1 = configuração salva, mas o HTTPS não respondeu a tempo.
apply_domain_config() {
  local domain=$1 email=$2 i code=""
  backup_env
  env_set SITE_ADDRESS "$domain"
  env_set PUBLIC_URL "https://${domain}"
  env_set ACME_EMAIL "$email"
  info "Aplicando (reinicia o servidor web e o sistema)..."
  compose up -d --force-recreate backend web >/dev/null
  update_cred_file "Endereço" "https://${domain}"
  info "Emitindo certificado HTTPS (até $(( HTTPS_WAIT_STEPS * 5 / 60 )) minutos)..."
  for (( i = 1; i <= HTTPS_WAIT_STEPS; i++ )); do
    code=$(https_health_code "$domain")
    [[ "$code" == 200 ]] && return 0
    sleep 5
  done
  return 1
}

# Volta SITE_ADDRESS / PUBLIC_URL / ACME_EMAIL para os valores anteriores
restore_address() {
  local site=$1 url=$2 acme=$3
  info "Voltando para o endereço anterior (${url})..."
  env_set SITE_ADDRESS "${site:-:80}"
  env_set PUBLIC_URL "$url"
  env_set ACME_EMAIL "$acme"
  compose up -d --force-recreate backend web >/dev/null
  update_cred_file "Endereço" "$url"
  wait_healthy 240 || true
}

# run_domain_change DOMINIO EMAIL MODO   (MODO: auto = sem perguntas | manual)
# Domínio e e-mail JÁ validados pelo chamador.
run_domain_change() {
  local domain=$1 email=$2 mode=$3 ip ips prev_site prev_url prev_acme msg
  [[ "$HAS_TTY" == 1 ]] || mode=auto
  ip=$(server_ip)
  ips=$(domain_ips "$domain")

  if [[ "$(env_get SITE_ADDRESS)" == "$domain" && "$(public_url)" == "https://${domain}" \
        && "$(https_health_code "$domain")" == 200 ]]; then
    rm -f -- "$DOMAIN_REQUEST_FILE"
    write_domain_status applied "O domínio ${domain} já estava ativo com HTTPS." "$domain"
    ok "O domínio ${domain} já está ativo: https://${domain}"
    return 0
  fi

  if ! dns_points_here "$ips" "$ip"; then
    msg="O domínio ${domain} aponta para ${ips:-nenhum IP}, mas o IP deste servidor é ${ip:-desconhecido}. Corrija o DNS (DuckDNS ou registro A), espere alguns minutos e tente de novo."
    if [[ "$mode" == auto ]]; then
      warn "$msg"
      write_domain_status error "$msg" "$domain"
      return 1
    fi
    ask_yesno "Domínio ainda não aponta para cá" \
"${domain} aponta para: ${ips:-nenhum IP}
IP deste servidor: ${ip}

Sem isso o certificado HTTPS NÃO será emitido e o site fica fora do ar
pelo domínio. A mudança de DNS pode levar alguns minutos.

Aplicar mesmo assim?  (Recomendado: Não, espere e tente de novo)" || { info "Nada alterado."; return 1; }
  fi

  prev_site=$(env_get SITE_ADDRESS)
  prev_url=$(public_url)
  prev_acme=$(env_get ACME_EMAIL)
  DOMAIN_JOB_DOMAIN=$domain
  # Um pedido antigo do painel não deve ser aplicado depois desta troca
  rm -f -- "$DOMAIN_REQUEST_FILE"
  write_domain_status pending "Aplicando o domínio ${domain}. O painel fica fora do ar por cerca de 1 minuto." "$domain"

  if apply_domain_config "$domain" "$email"; then
    DOMAIN_JOB_DOMAIN=""
    write_domain_status applied "HTTPS ativo. Novo endereço: https://${domain}" "$domain"
    ok "Pronto! Acesse: https://${domain}"
    return 0
  fi

  msg="O certificado HTTPS de ${domain} não foi emitido em $(( HTTPS_WAIT_STEPS * 5 / 60 )) minutos."
  if [[ "$mode" == auto ]] || ask_yesno "HTTPS ainda não respondeu" \
"${msg}

Verifique:
- o domínio aponta para ${ip}?
- portas 80 e 443 liberadas? (Google Cloud: 'Permitir tráfego HTTP' e 'HTTPS' na VM)

Voltar para o endereço anterior (${prev_url})?

Sim = voltar agora   Não = manter o domínio (o Caddy continua tentando sozinho)"; then
    restore_address "$prev_site" "$prev_url" "$prev_acme"
    DOMAIN_JOB_DOMAIN=""
    msg+=" Voltei para o endereço anterior (${prev_url}). Confira se o domínio aponta para ${ip} e se as portas 80 e 443 estão liberadas (Google Cloud: marque 'Permitir tráfego HTTP' e 'Permitir tráfego HTTPS' na VM). Depois tente de novo."
    warn "$msg"
    write_domain_status error "$msg" "$domain"
    return 1
  fi
  DOMAIN_JOB_DOMAIN=""
  msg+=" A configuração foi mantida e o servidor continua tentando. Detalhes: sudo atendia logs web"
  warn "$msg"
  write_domain_status error "$msg" "$domain"
  return 1
}

# Chamado pelo cron a cada minuto. SILENCIOSO quando não há pedido.
cmd_aplicar_dominio_pendente() {
  local file=$DOMAIN_REQUEST_FILE domain email by size
  [[ -e "$file" || -L "$file" ]] || return 0
  take_domain_lock || return 0          # outra execução já está cuidando
  [[ -e "$file" || -L "$file" ]] || return 0

  printf '\n[%s] Pedido de domínio encontrado.\n' "$(date '+%d/%m/%Y %H:%M:%S')"
  if [[ -L "$file" || ! -f "$file" ]]; then
    rm -f -- "$file"
    warn "Pedido ignorado: o arquivo de controle não é um arquivo comum."
    write_domain_status error "Pedido inválido. Faça o pedido de novo pelo painel."
    return 0
  fi
  size=$(stat -c %s "$file" 2>/dev/null || echo 999999)
  if (( size > 65536 )); then
    rm -f -- "$file"
    warn "Pedido ignorado: arquivo grande demais."
    write_domain_status error "Pedido inválido. Faça o pedido de novo pelo painel."
    return 0
  fi

  domain=$(read_json_field "$file" domain; printf .); domain=${domain%.}
  email=$(read_json_field "$file" email; printf .); email=${email%.}
  by=$(read_json_field "$file" requestedBy | tr -cd 'A-Za-z0-9@._+-' | cut -c1-100 || true)
  # Pedido "consumido": nunca é processado duas vezes
  rm -f -- "$file"

  if ! valid_domain_strict "$domain"; then
    warn "Pedido ignorado: domínio inválido."
    write_domain_status error "Domínio inválido no pedido. Use só letras minúsculas, números, hífens e pontos (ex.: minhaempresa.duckdns.org)."
    return 0
  fi
  if ! valid_email_strict "$email"; then
    warn "Pedido ignorado: e-mail inválido."
    write_domain_status error "E-mail inválido no pedido. Faça o pedido de novo pelo painel." "$domain"
    return 0
  fi
  info "Domínio pedido pelo painel: ${domain} (por ${by:-?})"
  run_domain_change "$domain" "$email" auto || true
}

# Valor padrão para o e-mail do certificado
default_acme_email() {
  local e
  e=$(env_get ACME_EMAIL)
  [[ -z "$e" || "$e" == *@atendia.local ]] && e=$(env_get ATENDIA_ADMIN_EMAIL)
  printf '%s' "$e"
}

# sudo atendia dominio                    -> assistente (menu)
# sudo atendia dominio <dominio> [email]  -> aplica direto (pergunta só o necessário)
cmd_dominio() {
  if [[ -z "${1:-}" ]]; then need_tty; config_domain; return 0; fi
  local domain email
  domain=$(normalize_domain "$1")
  valid_domain_strict "$domain" \
    || die "Domínio inválido: \"$1\". Use só letras, números, hífens e pontos (ex.: minhaempresa.duckdns.org)."
  email=$(printf '%s' "${2:-}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  if [[ -z "$email" ]]; then
    email=$(default_acme_email)
    if [[ "$HAS_TTY" == 1 ]]; then
      email=$(ask_input "E-mail para o certificado" "E-mail para avisos do certificado HTTPS (Let's Encrypt):" "$email") || die "Cancelado."
      email=$(printf '%s' "$email" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    fi
  fi
  valid_email_strict "$email" || die "E-mail inválido: \"${email}\". Informe assim: sudo atendia dominio ${domain} voce@exemplo.com"
  ensure_control_dir
  take_domain_lock || die "Já existe uma troca de domínio em andamento. Aguarde 1 minuto e tente de novo."
  info "Domínio: ${domain}   E-mail do certificado: ${email}   IP do servidor: $(server_ip)"
  run_domain_change "$domain" "$email" manual
}

# --- config: domínio + HTTPS (menu) -------------------------------------------
config_domain() {
  local ip domain email current
  ip=$(server_ip)
  current=$(env_get SITE_ADDRESS)
  [[ "$current" == :* ]] && current=""
  show_msg "Domínio e HTTPS" \
"Antes de continuar, o domínio precisa APONTAR para este servidor.

IP deste servidor:  ${ip}

Exemplo grátis com DuckDNS (duckdns.org):
 1. Entre com sua conta Google e crie um subdomínio (ex.: minhaempresa)
 2. No campo 'current ip' coloque ${ip} e clique em 'update ip'
 3. Seu domínio será: minhaempresa.duckdns.org

No Google Cloud, marque também 'Permitir tráfego HTTPS' na VM.
(Também dá para fazer isso pelo painel: Administração > Domínio e HTTPS.)"
  domain=$(ask_input "Domínio" "Digite o domínio (ex.: minhaempresa.duckdns.org):" "$current") || return 0
  domain=$(normalize_domain "$domain")
  [[ -n "$domain" ]] || return 0
  valid_domain_strict "$domain" || { show_msg "Domínio inválido" "\"${domain}\" não parece um domínio válido.\nUse só letras, números, hífens e pontos (ex.: minhaempresa.duckdns.org)."; return 0; }

  email=$(ask_input "E-mail para o certificado" "E-mail para avisos do certificado HTTPS (Let's Encrypt):" "$(default_acme_email)") || return 0
  email=$(printf '%s' "$email" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  valid_email_strict "$email" || { show_msg "E-mail inválido" "\"${email}\" não é um e-mail válido."; return 0; }

  ensure_control_dir
  take_domain_lock || { show_msg "Aguarde" "Já existe uma troca de domínio em andamento. Tente de novo em 1 minuto."; return 0; }
  if run_domain_change "$domain" "$email" manual; then
    show_msg "HTTPS ativo" "Tudo certo! Seu endereço agora é:\n\nhttps://${domain}\n\n(O acesso antigo pelo IP deixa de funcionar.)"
  else
    show_msg "Domínio não aplicado por completo" "Veja a mensagem no terminal.\nDetalhes do servidor web: sudo atendia logs web\nPara voltar ao IP: sudo atendia config > Voltar a usar só o IP"
  fi
}

config_ip_only() {
  local ip
  ip=$(detect_public_ip)
  ask_yesno "Voltar a usar só o IP" "O sistema passará a ser acessado por:\n\nhttp://${ip}\n\n(sem HTTPS). Continuar?" || return 0
  backup_env
  env_set SITE_ADDRESS ":80"
  env_set PUBLIC_URL "http://${ip}"
  env_set ATENDIA_PUBLIC_IP "$ip"
  valid_ipv4 "${ip:-x}" && env_set SERVER_PUBLIC_IP "$ip"
  compose up -d --force-recreate backend web >/dev/null
  update_cred_file "Endereço" "http://${ip}"
  wait_healthy 240 || true
  ok "Agora o acesso é por http://${ip}"
}

# --- estrutura para o painel trocar o domínio (instalações antigas: via update) ---
ensure_control_dir() {
  [[ -L "$CONTROL_DIR" ]] && rm -f -- "$CONTROL_DIR"
  mkdir -p "$CONTROL_DIR"
  chown "${CONTROL_UID}:${CONTROL_GID}" "$CONTROL_DIR"
  chmod 750 "$CONTROL_DIR"
}

ensure_domain_cron() {
  local tmp
  if [[ -f "$CRON_FILE" ]] && grep -qF -- "$DOMAIN_CRON_LINE" "$CRON_FILE"; then return 0; fi
  # Arquivo temporário em /etc/cron.d com "." no nome: o cron ignora até o mv
  tmp=$(mktemp "/etc/cron.d/.atendia.XXXXXX")
  if [[ -f "$CRON_FILE" ]]; then
    grep -vF 'aplicar-dominio-pendente' "$CRON_FILE" > "$tmp" || true
    [[ -z "$(tail -c 1 "$tmp")" ]] || printf '\n' >> "$tmp"
  else
    printf '# AtendIA — backup diário às 03:00 (mantém os 7 mais recentes em %s/backups)\nSHELL=/bin/bash\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n0 3 * * * root %s backup --auto >> /var/log/atendia-backup.log 2>&1\n' \
      "$ATENDIA_DIR" "$CLI_PATH" > "$tmp"
  fi
  printf '%s\n' "$DOMAIN_CRON_LINE" >> "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$CRON_FILE"
  systemctl enable --now cron >/dev/null 2>&1 || true
}

ensure_logrotate() {
  local f=/etc/logrotate.d/atendia
  [[ -f "$f" ]] && grep -qF 'atendia-domain.log' "$f" && return 0
  cat > "$f" <<'EOF'
/var/log/atendia-backup.log /var/log/atendia-install.log /var/log/atendia-domain.log {
  monthly
  rotate 3
  compress
  missingok
  notifempty
}
EOF
}

ensure_server_ip_env() {
  local ip
  ip=$(detect_public_ip)
  if valid_ipv4 "${ip:-x}" && [[ "$(env_get SERVER_PUBLIC_IP)" != "$ip" ]]; then
    env_set SERVER_PUBLIC_IP "$ip"
  fi
}

ensure_domain_infra() {
  ensure_control_dir
  ensure_domain_cron
  ensure_logrotate
  ensure_server_ip_env
}

# --- config: chaves de IA ---------------------------------------------------
set_optional_key() {
  # set_optional_key VAR "Título" "Texto"
  local var=$1 title=$2 text=$3 cur hint val
  cur=$(env_get "$var")
  hint="(Enter = deixar como está"
  [[ -n "$cur" ]] && hint+="; atual: ${cur:0:6}…${cur: -4}"
  hint+="; digite - para APAGAR)"
  val=$(ask_input "$title" "${text}\n\n${hint}" "") || return 1
  val=$(printf '%s' "$val" | tr -d '[:space:]')
  [[ -z "$val" ]] && return 1
  [[ "$val" == "-" ]] && val=""
  env_set "$var" "$val"
  return 0
}

config_ai() {
  local changed=0
  set_optional_key OPENAI_API_KEY "Chave OpenAI" "Cole a chave da OpenAI (começa com sk-).\nOnde conseguir: platform.openai.com > API keys" && changed=1
  set_optional_key ANTHROPIC_API_KEY "Chave Anthropic (Claude)" "Cole a chave da Anthropic (começa com sk-ant-).\nOnde conseguir: console.anthropic.com > API Keys" && changed=1
  if [[ $changed == 1 ]]; then
    compose up -d backend >/dev/null
    wait_healthy 240 || true
    ok "Chaves de IA atualizadas."
  else
    info "Nada alterado."
  fi
}

# --- config: SMTP -------------------------------------------------------------
config_smtp() {
  local host port secure user pass from
  show_msg "E-mail (SMTP)" "Usado para recuperação de senha e avisos.\n\nExemplo Gmail: servidor smtp.gmail.com, porta 587,\nusuário = seu Gmail, senha = 'senha de app'\n(myaccount.google.com > Segurança > Senhas de app)."
  host=$(ask_input "SMTP" "Servidor SMTP:" "$(env_get SMTP_HOST)") || return 0
  port=$(ask_input "SMTP" "Porta (587 = padrão; 465 = SSL):" "$(env_get SMTP_PORT)") || return 0
  [[ "$port" =~ ^[0-9]+$ ]] || port=587
  secure=false; [[ "$port" == 465 ]] && secure=true
  user=$(ask_input "SMTP" "Usuário (normalmente o e-mail):" "$(env_get SMTP_USER)") || return 0
  pass=$(ask_password "SMTP" "Senha do SMTP (Enter = manter a atual):") || return 0
  from=$(ask_input "SMTP" "Remetente (como aparece para quem recebe):" "$(env_get EMAIL_FROM)") || return 0
  from=${from//\'/’}
  backup_env
  env_set SMTP_HOST "$(printf '%s' "$host" | tr -d '[:space:]')"
  env_set SMTP_PORT "$port"
  env_set SMTP_SECURE "$secure"
  env_set SMTP_USER "$(printf '%s' "$user" | tr -d '[:space:]')"
  [[ -n "$pass" ]] && env_set SMTP_PASS "$pass"
  [[ -n "$from" ]] && env_set EMAIL_FROM "$from"
  compose up -d backend >/dev/null
  wait_healthy 240 || true
  ok "E-mail (SMTP) configurado."
}

# --- config: Mercado Pago -----------------------------------------------------
config_mp() {
  local url token secret
  url="$(public_url)/api/payments/webhook/mercadopago"
  show_msg "Mercado Pago" "1. Acesse mercadopago.com.br/developers > Suas integrações > (sua aplicação)
2. Em 'Credenciais de produção' copie o Access Token
3. Em 'Webhooks' cadastre a URL abaixo (evento: Pagamentos)
   e copie a 'Assinatura secreta':

${url}

Importante: o Mercado Pago exige HTTPS — configure um domínio antes."
  token=$(ask_input "Mercado Pago" "Access Token (APP_USR-...). Enter = manter:" "") || return 0
  secret=$(ask_input "Mercado Pago" "Assinatura secreta do webhook. Enter = manter:" "") || return 0
  token=$(printf '%s' "$token" | tr -d '[:space:]'); secret=$(printf '%s' "$secret" | tr -d '[:space:]')
  if [[ -z "$token" && -z "$secret" ]]; then info "Nada alterado."; return 0; fi
  backup_env
  [[ -n "$token" ]] && env_set MP_ACCESS_TOKEN "$token"
  [[ -n "$secret" ]] && env_set MP_WEBHOOK_SECRET "$secret"
  if [[ "$token" == TEST-* ]]; then env_set MP_SANDBOX true; elif [[ -n "$token" ]]; then env_set MP_SANDBOX false; fi
  compose up -d backend >/dev/null
  wait_healthy 240 || true
  ok "Mercado Pago configurado. URL do webhook: ${url}"
}

cmd_config() {
  need_tty
  local choice
  while :; do
    choice=$(ask_menu "AtendIA — Configurações" "Endereço atual: $(public_url)\n\nO que deseja configurar?" \
      dominio  "Domínio + HTTPS (cadeado)" \
      ip       "Voltar a usar só o IP (sem domínio)" \
      ia       "Chaves de IA (OpenAI / Anthropic)" \
      smtp     "E-mail de envio (SMTP)" \
      mp       "Mercado Pago (pagamentos)" \
      senha    "Trocar senha do administrador" \
      info     "Ver endereço e dados de acesso") || break
    case "$choice" in
      dominio) config_domain ;;
      ip)      config_ip_only ;;
      ia)      config_ai ;;
      smtp)    config_smtp ;;
      mp)      config_mp ;;
      senha)   cmd_senha_admin ;;
      info)    cmd_info; [[ "$USE_WHIPTAIL" == 1 ]] && { printf 'Enter para voltar ao menu...'; IFS= read -r _ </dev/tty || true; } ;;
      *) break ;;
    esac
  done
}

cmd_desinstalar() {
  need_tty
  ask_yesno "Desinstalar o AtendIA" "Isso vai PARAR e APAGAR o AtendIA deste servidor:\nbanco de dados, conversas, sessões do WhatsApp e arquivos.\n\nUm backup final será feito e os backups serão movidos para\n/root/atendia-backups (NÃO são apagados).\n\nDeseja continuar?" || die "Cancelado."
  local answer
  answer=$(ask_input "Confirmação final" "Digite DESINSTALAR (em maiúsculas) para confirmar:" "") || die "Cancelado."
  [[ "$answer" == "DESINSTALAR" ]] || die "Cancelado (não digitou DESINSTALAR)."

  info "Backup final..."
  cmd_backup --auto || warn "Backup final falhou."
  mkdir -p /root/atendia-backups
  cp -p "$BACKUP_DIR"/atendia-backup-*.tar /root/atendia-backups/ 2>/dev/null || true
  cp -p "$ENV_FILE" /root/atendia-backups/config-final.env 2>/dev/null || true
  chmod -R go-rwx /root/atendia-backups

  info "Removendo containers, volumes e imagens..."
  compose down -v --rmi all --remove-orphans || true
  rm -f /etc/cron.d/atendia /etc/logrotate.d/atendia
  rm -rf "$ATENDIA_DIR"
  rm -f "$CLI_PATH"
  ok "AtendIA removido. Backups guardados em /root/atendia-backups"
  info "Docker e o swap continuam instalados (podem ser usados por outros programas)."
}

# ----------------------------------------------------------------------------
main() {
  local cmd=${1:-help}
  shift || true
  case "$cmd" in
    help|-h|--help|ajuda) cmd_help; return 0 ;;
  esac
  require_root "$cmd"
  require_install
  case "$cmd" in
    status)                 cmd_status ;;
    info)                   cmd_info ;;
    logs|log)               cmd_logs "$@" ;;
    restart|reiniciar)      cmd_restart "$@" ;;
    stop|parar)             cmd_stop ;;
    start|iniciar)          cmd_start ;;
    update|atualizar)       cmd_update "$@" ;;
    backup)                 cmd_backup "$@" ;;
    restore|restaurar)      cmd_restore "$@" ;;
    config|configurar)      cmd_config ;;
    dominio|domain)         cmd_dominio "$@" ;;
    aplicar-dominio-pendente) cmd_aplicar_dominio_pendente ;;
    senha-admin|senha)      cmd_senha_admin ;;
    desinstalar|uninstall)  cmd_desinstalar ;;
    *) fail "Comando desconhecido: ${cmd}"; cmd_help; exit 1 ;;
  esac
}

# "exit" na mesma linha: o bash não lê mais nada do arquivo depois (seguro durante o update)
main "$@"; exit $?
