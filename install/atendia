cmd_info() {
  local url
  url=$(public_url)
  printf '\n  %s %s\n' "${C_BOLD}Endereço:${C_RESET}" "${C_CYAN}${url}${C_RESET}"
  printf '  %s %s\n' "${C_BOLD}Administrador:${C_RESET}" "$(env_get ATENDIA_ADMIN_EMAIL)"
  printf '  %s %s\n' "${C_BOLD}Credenciais:${C_RESET}" "${CRED_FILE}  (ver: sudo cat ${CRED_FILE})"
  printf '  %s %s\n' "${C_BOLD}Configuração:${C_RESET}" "$ENV_FILE"
  printf '  %s %s\n' "${C_BOLD}Backups:${C_RESET}" "$BACKUP_DIR"
  printf '  %s %s\n' "${C_BOLD}Versão:${C_RESET}" "$(git -C "$ATENDIA_DIR" log -1 --format='%h (%cd)' --date=format:'%d/%m/%Y' 2>/dev/null || echo '?')"
  printf '  %s %s\n\n' "${C_BOLD}Webhook Mercado Pago:${C_RESET}" "${url}/api/payments/webhook/mercadopago"
}

cmd_status() {
  local url status code
  url=$(public_url)
  printf '\n%s\n' "${C_BOLD}Serviços${C_RESET}"
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}' 2>/dev/null || compose ps
  printf '\n%s\n' "${C_BOLD}Uso de memória/CPU${C_RESET}"
  local ids
  ids=$(compose ps -q 2>/dev/null || true)
  if [[ -n "$ids" ]]; then
    # shellcheck disable=SC2086
    docker stats --no-stream --format 'table {{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}' $ids || true
  fi
  printf '\n%s\n' "${C_BOLD}Servidor${C_RESET}"
  free -m | awk 'NR==1 {print "              total   usado   livre"} /^Mem:/ {printf "  RAM (MB):   %6s  %6s  %6s\n", $2, $3, $7} /^Swap:/ {printf "  Swap (MB):  %6s  %6s  %6s\n", $2, $3, $4}'
  df -h / | awk 'NR==2 {printf "  Disco:      %s usados de %s (%s livres)\n", $3, $2, $4}'

  status=$(backend_health)
  code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' http://127.0.0.1/health 2>/dev/null || true)
  printf '\n%s\n' "${C_BOLD}Situação${C_RESET}"
  if [[ "$status" == healthy ]]; then ok "Sistema: funcionando"; else warn "Sistema: ${status}"; fi
  case "$code" in
    200) ok "Servidor web: respondendo" ;;
    301|302|308) ok "Servidor web: respondendo (redireciona para HTTPS)" ;;
    *) warn "Servidor web: sem resposta (${code:-nenhuma}) — veja: sudo atendia logs web" ;;
  esac
  printf '  Endereço: %s\n\n' "${C_CYAN}${url}${C_RESET}"
}

cmd_logs() {
  local svc=${1:-backend}
  case "$svc" in
    todos|all|tudo) compose logs -f --tail=100 ;;
    api|sistema|app) compose logs -f --tail=100 backend ;;
    banco|db) compose logs -f --tail=100 postgres ;;
    site|caddy) compose logs -f --tail=100 web ;;
    fila) compose logs -f --tail=100 redis ;;
    *) compose logs -f --tail=100 "$svc" ;;
  esac
}

cmd_restart() {
  if [[ -n "${1:-}" ]]; then
    compose restart "$1"
  else
    compose restart
  fi
  ok "Reiniciado."
  wait_healthy 240 || true
}

cmd_stop()  { compose stop; ok "Sistema parado. Para voltar: sudo atendia start"; }
cmd_start() { compose up -d; wait_healthy 240 || true; cmd_info; }

install_self() {
  # Troca atômica (novo arquivo + mv): o script em execução não é corrompido
  if [[ -f "$ATENDIA_DIR/install/atendia" ]]; then
    install -m 755 "$ATENDIA_DIR/install/atendia" "${CLI_PATH}.new"
    mv -f "${CLI_PATH}.new" "$CLI_PATH"
  fi
}

cmd_update() {
  info "Fazendo backup antes de atualizar..."
  cmd_backup --auto || warn "Backup falhou — continuando a atualização mesmo assim."

  info "Baixando a versão mais nova do código..."
  local branch
  branch=$(git -C "$ATENDIA_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
  [[ "$branch" == HEAD ]] && branch=main
  git -C "$ATENDIA_DIR" fetch --depth 1 origin "$branch" >/dev/null
  if [[ -n "$(git -C "$ATENDIA_DIR" status --porcelain --untracked-files=no)" ]]; then
    local patch
    patch="$BACKUP_DIR/alteracoes-locais-$(date +%Y%m%d-%H%M%S).patch"
    git -C "$ATENDIA_DIR" diff > "$patch" || true
    warn "Havia arquivos editados à mão; cópia das alterações em ${patch}"
  fi
  git -C "$ATENDIA_DIR" reset --hard FETCH_HEAD >/dev/null
  ok "Código atualizado: $(git -C "$ATENDIA_DIR" log -1 --format='%h %s')"
  install_self

  if [[ "$(env_get COMPOSE_FILE)" == *build* ]]; then
    info "Compilando as imagens no servidor (pode demorar bastante)..."
    compose pull --quiet --ignore-buildable 2>/dev/null || true
    compose build
  else
    info "Baixando imagens novas..."
    compose pull --quiet
  fi
  compose up -d --remove-orphans
  docker image prune -f >/dev/null 2>&1 || true
  wait_healthy 300
  ok "Atualização concluída."
}

cmd_backup() {
  local auto=0
  [[ "${1:-}" == "--auto" ]] && auto=1
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"

  local free_mb
  free_mb=$(df -Pm "$BACKUP_DIR" | awk 'NR==2 {print $4}')
  if (( free_mb < 500 )); then
    die "Pouco espaço em disco (${free_mb} MB livres). Apague backups antigos em ${BACKUP_DIR}."
  fi

  local ts work final
  ts=$(date +%Y%m%d-%H%M%S)
  work=$(mktemp -d "$BACKUP_DIR/.tmp-${ts}-XXXX")
  CLEANUP+=("$work")
  final="$BACKUP_DIR/atendia-backup-${ts}.tar"

  [[ $auto == 1 ]] && printf '[%s] ' "$(date '+%d/%m/%Y %H:%M:%S')"
  info "Copiando o banco de dados..."
  compose exec -T postgres pg_dump -U atend -d atend_ia --no-owner --no-privileges | gzip -6 > "$work/banco.sql.gz"
  gzip -t "$work/banco.sql.gz"

  info "Copiando arquivos (WhatsApp e anexos)..."
  compose run --rm --no-deps -T --entrypoint tar backend \
    czf - -C /app/data --exclude='./tmp' --exclude='*.tmp' --exclude='*.part' . > "$work/arquivos.tar.gz"

  cp -p "$ENV_FILE" "$work/config.env"
  {
    printf 'AtendIA backup %s\n' "$ts"
    printf 'Versão: %s\n' "$(git -C "$ATENDIA_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
    printf 'Endereço: %s\n' "$(public_url)"
  } > "$work/info.txt"

  tar cf "$final" -C "$work" banco.sql.gz arquivos.tar.gz config.env info.txt
  chmod 600 "$final"
  rm -rf "$work"

  # Mantém só os N mais recentes
  local old
  while IFS= read -r old; do
    [[ -n "$old" ]] && rm -f -- "$old"
  done < <(find "$BACKUP_DIR" -maxdepth 1 -name 'atendia-backup-*.tar' -printf '%T@ %p\n' | sort -rn | awk -v k="$BACKUP_KEEP" 'NR > k {print $2}')

  ok "Backup salvo: ${final} ($(du -h "$final" | cut -f1))"
  if [[ $auto == 0 ]]; then
    info "Dica: copie os backups para fora do servidor de vez em quando (ex.: scp ou Google Drive)."
  fi
}

list_backups() {
  printf '\n  Backups disponíveis em %s:\n' "$BACKUP_DIR"
  find "$BACKUP_DIR" -maxdepth 1 -name 'atendia-backup-*.tar' -printf '    %f  (%TY-%Tm-%Td %TH:%TM, %s bytes)\n' 2>/dev/null | sort -r || true
  printf '\n  Uso: sudo atendia restore <arquivo>\n\n'
}

cmd_restore() {
  local file=${1:-}
  if [[ -z "$file" ]]; then list_backups; return 0; fi
  [[ -f "$file" ]] || file="$BACKUP_DIR/$file"
  [[ -f "$file" ]] || die "Arquivo não encontrado: ${1}"

  local work
  work=$(mktemp -d)
  CLEANUP+=("$work")
  tar xf "$file" -C "$work" || die "Arquivo de backup inválido ou corrompido."
  [[ -f "$work/banco.sql.gz" ]] || die "Este arquivo não parece um backup do AtendIA (falta banco.sql.gz)."
  gzip -t "$work/banco.sql.gz" || die "O banco dentro do backup está corrompido."

  need_tty
  printf '\n%s\n' "${C_YELLOW}${C_BOLD}ATENÇÃO:${C_RESET}${C_YELLOW} restaurar APAGA os dados atuais e volta tudo para o backup:${C_RESET}"
  sed 's/^/    /' "$work/info.txt" 2>/dev/null || true
  local answer
  answer=$(ask_input "Confirmar restauração" "Isso vai SUBSTITUIR todos os dados atuais pelos do backup.\n(Um backup de segurança do estado atual será feito antes.)\n\nDigite RESTAURAR para confirmar:" "") || die "Cancelado."
  [[ "$answer" == "RESTAURAR" ]] || die "Cancelado (não digitou RESTAURAR)."

  info "Backup de segurança do estado atual..."
  cmd_backup --auto || die "Não consegui fazer o backup de segurança; restauração cancelada."

  info "Parando o sistema..."
  compose stop backend web >/dev/null 2>&1 || true
  compose up -d postgres redis >/dev/null

  info "Restaurando o banco de dados..."
  compose exec -T postgres psql -U atend -d postgres -v ON_ERROR_STOP=1 -q \
    -c 'DROP DATABASE IF EXISTS atend_ia WITH (FORCE);' -c 'CREATE DATABASE atend_ia OWNER atend;' >/dev/null
  gunzip -c "$work/banco.sql.gz" | compose exec -T postgres psql -U atend -d atend_ia -v ON_ERROR_STOP=1 -q >/dev/null
  ok "Banco restaurado."

  if [[ -s "$work/arquivos.tar.gz" ]]; then
    info "Restaurando arquivos (WhatsApp e anexos)..."
    compose run --rm --no-deps -T --entrypoint sh backend \
      -c 'find /app/data -mindepth 1 -delete && tar xzf - -C /app/data' < "$work/arquivos.tar.gz"
    ok "Arquivos restaurados."
  fi

  if ! cmp -s "$work/config.env" "$ENV_FILE" 2>/dev/null; then
    warn "A configuração (.env) do backup é diferente da atual e NÃO foi alterada."
    warn "Se o servidor é novo, as chaves antigas estão em: tar xf ${file} config.env"
  fi

  compose up -d
  wait_healthy 300 || true
  ok "Restauração concluída."
}

run_create_admin() {
  # run_create_admin EMAIL SENHA [--reset-password]
  local email=$1 pw=$2 flag=${3:-} company
  company=$(env_get ATENDIA_COMPANY_NAME)
  compose exec -T backend test -f dist/scripts/create-admin.js \
    || die "Script create-admin não encontrado nesta versão. Atualize: sudo atendia update"
  (cd "$ATENDIA_DIR" && ADMIN_EMAIL="$email" ADMIN_PASSWORD="$pw" COMPANY_NAME="${company:-Minha Empresa}" ADMIN_NAME="Administrador" \
    docker compose exec -T -e ADMIN_EMAIL -e ADMIN_PASSWORD -e COMPANY_NAME -e ADMIN_NAME \
    backend node dist/scripts/create-admin.js ${flag:+"$flag"})
}

cmd_senha_admin() {
  need_tty
  local email pw p2 generated=0
  email=$(ask_input "Trocar senha do administrador" "E-mail do administrador:" "$(env_get ATENDIA_ADMIN_EMAIL)") || die "Cancelado."
  email=$(printf '%s' "$email" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  valid_email "$email" || die "E-mail inválido."
  while :; do
    pw=$(ask_password "Nova senha" "Nova senha (8+ caracteres, com maiúscula, minúscula e número).\n\nAperte Enter para GERAR uma senha forte automaticamente.") || die "Cancelado."
    if [[ -z "$pw" ]]; then pw=$(gen_password); generated=1; break; fi
    if ! password_ok "$pw"; then show_msg "Senha fraca" "Use 8+ caracteres, com maiúscula, minúscula e número (sem aspas simples)."; continue; fi
    p2=$(ask_password "Nova senha" "Digite a mesma senha de novo:") || die "Cancelado."
    [[ "$pw" == "$p2" ]] && break
    show_msg "Senhas diferentes" "As senhas não conferem. Tente de novo."
  done
  run_create_admin "$email" "$pw" --reset-password
  if [[ "$email" == "$(env_get ATENDIA_ADMIN_EMAIL)" ]]; then
    update_cred_file "Senha" "$pw"
  fi
  ok "Senha alterada para ${email}."
  if [[ $generated == 1 ]]; then
    printf '\n  %s %s\n  %s\n\n' "${C_BOLD}Nova senha:${C_RESET}" "$pw" "(anote! também salva em ${CRED_FILE})" >/dev/tty
  fi
}

# --- config: domínio + HTTPS -------------------------------------------------
config_domain() {
  local ip domain email resolved current
  ip=$(detect_public_ip)
  current=$(env_get SITE_ADDRESS)
  [[ "$current" == :* ]] && current=""
  show_msg "Domínio e HTTPS" \
"Antes de continuar, o domínio precisa APONTAR para este servidor.

IP deste servidor:  ${ip}

Exemplo grátis com DuckDNS (duckdns.org):
 1. Entre com sua conta Google e crie um subdomínio (ex.: minhaempresa)
 2. No campo 'current ip' coloque ${ip} e clique em 'update ip'
 3. Seu domínio será: minhaempresa.duckdns.org

No Google Cloud, marque também 'Permitir tráfego HTTPS' na VM."
  domain=$(ask_input "Domínio" "Digite o domínio (ex.: minhaempresa.duckdns.org):" "$current") || return 0
  domain=$(printf '%s' "$domain" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  domain=${domain#http://}; domain=${domain#https://}; domain=${domain%%/*}
  [[ -n "$domain" ]] || return 0
  valid_domain "$domain" || { show_msg "Domínio inválido" "\"${domain}\" não parece um domínio válido."; return 0; }

  resolved=$(getent ahostsv4 "$domain" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' || true)
  if [[ " $resolved " != *" $ip "* ]]; then
    ask_yesno "Domínio ainda não aponta para cá" \
"${domain} aponta para: ${resolved:-nenhum IP}
IP deste servidor: ${ip}

Sem isso o certificado HTTPS NÃO será emitido e o site fica fora do ar
pelo domínio. A mudança de DNS pode levar alguns minutos.

Aplicar mesmo assim?  (Recomendado: Não, espere e tente de novo)" || return 0
  fi

  email=$(ask_input "E-mail para o certificado" "E-mail para avisos do certificado HTTPS (Let's Encrypt):" "$(env_get ACME_EMAIL)") || return 0
  valid_email "$email" || { show_msg "E-mail inválido" "\"${email}\" não é um e-mail válido."; return 0; }

  backup_env
  env_set SITE_ADDRESS "$domain"
  env_set PUBLIC_URL "https://${domain}"
  env_set ACME_EMAIL "$email"
  info "Aplicando (reinicia o servidor web e o sistema)..."
  compose up -d --force-recreate backend web >/dev/null
  update_cred_file "Endereço" "https://${domain}"

  info "Emitindo certificado HTTPS (até 2 minutos)..."
  local i code=""
  for i in $(seq 1 24); do
    code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "https://${domain}/health" 2>/dev/null || true)
    [[ "$code" == 200 ]] && break
    sleep 5
  done
  if [[ "$code" == 200 ]]; then
    ok "Pronto! Acesse: https://${domain}"
    show_msg "HTTPS ativo" "Tudo certo! Seu endereço agora é:\n\nhttps://${domain}\n\n(O acesso antigo pelo IP deixa de funcionar.)"
  else
    warn "O HTTPS ainda não respondeu. Veja: sudo atendia logs web"
    show_msg "HTTPS ainda não respondeu" "Configuração salva, mas o certificado ainda não foi emitido.\n\nVerifique:\n- o domínio aponta para ${ip}?\n- 'Permitir tráfego HTTPS' marcado no Google Cloud?\n\nO Caddy tenta de novo sozinho. Detalhes: sudo atendia logs web\nPara voltar ao IP: sudo atendia config > Voltar a usar só o IP"
  fi
}

config_ip_only() {
  local ip
  ip=$(detect_public_ip)
  ask_yesno "Voltar a usar só o IP" "O sistema passará a ser acessado por:\n\nhttp://${ip}\n\n(sem HTTPS). Continuar?" || return 0
  backup_env
  env_set SITE_ADDRESS ":80"
  env_set PUBLIC_URL "http://${ip}"
  env_set ATENDIA_PUBLIC_IP "$ip"
  compose up -d --force-recreate backend web >/dev/null
  update_cred_file "Endereço" "http://${ip}"
  wait_healthy 240 || true
  ok "Agora o acesso é por http://${ip}"
}

# --- config: chaves de IA ---------------------------------------------------
set_optional_key() {
  # set_optional_key VAR "Título" "Texto"
  local var=$1 title=$2 text=$3 cur hint val
  cur=$(env_get "$var")
  hint="(Enter = deixar como está"
  [[ -n "$cur" ]] && hint+="; atual: ${cur:0:6}…${cur: -4}"
  hint+="; digite - para APAGAR)"
  val=$(ask_input "$title" "${text}\n\n${hint}" "") || return 1
  val=$(printf '%s' "$val" | tr -d '[:space:]')
  [[ -z "$val" ]] && return 1
  [[ "$val" == "-" ]] && val=""
  env_set "$var" "$val"
  return 0
}

config_ai() {
  local changed=0
  set_optional_key OPENAI_API_KEY "Chave OpenAI" "Cole a chave da OpenAI (começa com sk-).\nOnde conseguir: platform.openai.com > API keys" && changed=1
  set_optional_key ANTHROPIC_API_KEY "Chave Anthropic (Claude)" "Cole a chave da Anthropic (começa com sk-ant-).\nOnde conseguir: console.anthropic.com > API Keys" && changed=1
  if [[ $changed == 1 ]]; then
    compose up -d backend >/dev/null
    wait_healthy 240 || true
    ok "Chaves de IA atualizadas."
  else
    info "Nada alterado."
  fi
}

# --- config: SMTP -------------------------------------------------------------
config_smtp() {
  local host port secure user pass from
  show_msg "E-mail (SMTP)" "Usado para recuperação de senha e avisos.\n\nExemplo Gmail: servidor smtp.gmail.com, porta 587,\nusuário = seu Gmail, senha = 'senha de app'\n(myaccount.google.com > Segurança > Senhas de app)."
  host=$(ask_input "SMTP" "Servidor SMTP:" "$(env_get SMTP_HOST)") || return 0
  port=$(ask_input "SMTP" "Porta (587 = padrão; 465 = SSL):" "$(env_get SMTP_PORT)") || return 0
  [[ "$port" =~ ^[0-9]+$ ]] || port=587
  secure=false; [[ "$port" == 465 ]] && secure=true
  user=$(ask_input "SMTP" "Usuário (normalmente o e-mail):" "$(env_get SMTP_USER)") || return 0
  pass=$(ask_password "SMTP" "Senha do SMTP (Enter = manter a atual):") || return 0
  from=$(ask_input "SMTP" "Remetente (como aparece para quem recebe):" "$(env_get EMAIL_FROM)") || return 0
  from=${from//\'/’}
  backup_env
  env_set SMTP_HOST "$(printf '%s' "$host" | tr -d '[:space:]')"
  env_set SMTP_PORT "$port"
  env_set SMTP_SECURE "$secure"
  env_set SMTP_USER "$(printf '%s' "$user" | tr -d '[:space:]')"
  [[ -n "$pass" ]] && env_set SMTP_PASS "$pass"
  [[ -n "$from" ]] && env_set EMAIL_FROM "$from"
  compose up -d backend >/dev/null
  wait_healthy 240 || true
  ok "E-mail (SMTP) configurado."
}

