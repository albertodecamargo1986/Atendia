#!/usr/bin/env bash
# =============================================================================
#  atendia — comando de gestão do AtendIA no servidor
#  Instalado em /usr/local/bin/atendia pelo install/install.sh
#
#  Uso:  sudo atendia <comando>      (sem comando = mostra a ajuda)
# =============================================================================
set -Eeuo pipefail

ATENDIA_DIR="${ATENDIA_DIR:-/opt/atendia}"
ENV_FILE="$ATENDIA_DIR/.env"
BACKUP_DIR="$ATENDIA_DIR/backups"
CRED_FILE="/root/atendia-credenciais.txt"
CLI_PATH="${ATENDIA_CLI_PATH:-/usr/local/bin/atendia}"
BACKUP_KEEP="${ATENDIA_BACKUP_KEEP:-7}"
# Pedidos do painel (Administração > Domínio e HTTPS). A pasta é montada no
# backend em /app/control; dono = usuário "app" do container (UID/GID fixos
# no Dockerfile.prod).
CONTROL_DIR="$ATENDIA_DIR/control"
CONTROL_UID=100
CONTROL_GID=101
DOMAIN_REQUEST_FILE="$CONTROL_DIR/domain-request.json"
DOMAIN_STATUS_FILE="$CONTROL_DIR/domain-status.json"
DOMAIN_LOCK_FILE="/var/lock/atendia-domain.lock"
CRON_FILE="/etc/cron.d/atendia"
DOMAIN_CRON_LINE="* * * * * root ${CLI_PATH} aplicar-dominio-pendente >> /var/log/atendia-domain.log 2>&1"
HTTPS_WAIT_STEPS=36   # 36 x 5s = 3 minutos esperando o certificado

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m' C_BOLD=$'\033[1m' C_RED=$'\033[31m' C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m' C_CYAN=$'\033[36m'
else
  C_RESET="" C_BOLD="" C_RED="" C_GREEN="" C_YELLOW="" C_CYAN=""
fi

info() { printf '%s\n' "  ${C_CYAN}•${C_RESET} $*"; }
ok()   { printf '%s\n' "  ${C_GREEN}✓${C_RESET} $*"; }
warn() { printf '%s\n' "  ${C_YELLOW}! $*${C_RESET}"; }
fail() { printf '%s\n' "  ${C_RED}✗ $*${C_RESET}" >&2; }
die()  { fail "$*"; exit 1; }

trap 'fail "Erro inesperado (linha $LINENO): $BASH_COMMAND"' ERR
CLEANUP=()
# Domínio em aplicação (pedido do painel). Se o script morrer no meio, o painel
# recebe um status de erro em vez de ficar "aplicando" para sempre.
DOMAIN_JOB_DOMAIN=""
cleanup() {
  if [[ -n "$DOMAIN_JOB_DOMAIN" ]]; then
    write_domain_status error "A aplicação do domínio foi interrompida. Rode no servidor: sudo atendia dominio ${DOMAIN_JOB_DOMAIN}" "$DOMAIN_JOB_DOMAIN" 2>/dev/null || true
  fi
  if (( ${#CLEANUP[@]} )); then rm -rf -- "${CLEANUP[@]}"; fi
}
trap cleanup EXIT

HAS_TTY=0
USE_WHIPTAIL=0
if (exec </dev/tty) 2>/dev/null && (exec >/dev/tty) 2>/dev/null; then
  HAS_TTY=1
  command -v whiptail >/dev/null 2>&1 && USE_WHIPTAIL=1
fi

# ----------------------------------------------------------------------------
# Perguntas (whiptail com fallback para read)
# ----------------------------------------------------------------------------
need_tty() { [[ "$HAS_TTY" == 1 ]] || die "Este comando precisa de um terminal interativo."; }

ask_input() {
  local title=$1 text=$2 default=${3:-} answer
  need_tty
  if [[ "$USE_WHIPTAIL" == 1 ]]; then
    answer=$(whiptail --title "$title" --inputbox "$text" 16 76 "$default" 3>&1 1>/dev/tty 2>&3 </dev/tty) || return 1
  else
    printf '\n%s\n%b\n' "${C_BOLD}${title}${C_RESET}" "$text" >/dev/tty
    if [[ -n "$default" ]]; then printf '[%s] > ' "$default" >/dev/tty; else printf '> ' >/dev/tty; fi
    IFS= read -r answer </dev/tty || return 1
    [[ -z "$answer" ]] && answer=$default
  fi
  printf '%s' "$answer"
}

ask_password() {
  local title=$1 text=$2 answer
  need_tty
  if [[ "$USE_WHIPTAIL" == 1 ]]; then
    answer=$(whiptail --title "$title" --passwordbox "$text" 16 76 3>&1 1>/dev/tty 2>&3 </dev/tty) || return 1
  else
    printf '\n%s\n%b\n> ' "${C_BOLD}${title}${C_RESET}" "$text" >/dev/tty
    IFS= read -rs answer </dev/tty || return 1
    printf '\n' >/dev/tty
  fi
  printf '%s' "$answer"
}

ask_yesno() {
  local title=$1 text=$2 answer
  need_tty
  if [[ "$USE_WHIPTAIL" == 1 ]]; then
    whiptail --title "$title" --yes-button "Sim" --no-button "Não" --yesno "$text" 20 78 </dev/tty >/dev/tty 2>&1
    return $?
  fi
  printf '\n%s\n%b\n(s/n) > ' "${C_BOLD}${title}${C_RESET}" "$text" >/dev/tty
  IFS= read -r answer </dev/tty || return 1
  [[ "$answer" =~ ^[sSyY] ]]
}

show_msg() {
  local title=$1 text=$2
  if [[ "$USE_WHIPTAIL" == 1 ]]; then
    whiptail --title "$title" --msgbox "$text" 20 78 </dev/tty >/dev/tty 2>&1 || true
  else
    printf '\n%s\n%b\n' "${C_BOLD}${title}${C_RESET}" "$text"
  fi
}

# ask_menu "Título" "Texto" tag1 "desc1" tag2 "desc2" ...
ask_menu() {
  local title=$1 text=$2; shift 2
  need_tty
  if [[ "$USE_WHIPTAIL" == 1 ]]; then
    whiptail --title "$title" --ok-button "Escolher" --cancel-button "Sair" \
      --menu "$text" 22 78 10 "$@" 3>&1 1>/dev/tty 2>&3 </dev/tty
    return $?
  fi
  printf '\n%s\n%b\n' "${C_BOLD}${title}${C_RESET}" "$text" >/dev/tty
  local i=1 tags=()
  while (( $# >= 2 )); do
    printf '  %d) %s\n' "$i" "$2" >/dev/tty
    tags+=("$1"); shift 2; i=$((i + 1))
  done
  printf '  0) Sair\n> ' >/dev/tty
  local n
  IFS= read -r n </dev/tty || return 1
  [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#tags[@]} )) || return 1
  printf '%s' "${tags[$((n - 1))]}"
}

# ----------------------------------------------------------------------------
# Utilidades
# ----------------------------------------------------------------------------
require_root() { [[ $EUID -eq 0 ]] || die "Use com sudo:  sudo atendia $*"; }
require_install() {
  [[ -f "$ATENDIA_DIR/docker-compose.yml" && -f "$ENV_FILE" ]] \
    || die "AtendIA não encontrado em ${ATENDIA_DIR}. Instale com o comando do guia (install/GUIA-INSTALACAO.md)."
}

compose() { (cd "$ATENDIA_DIR" && docker compose "$@"); }

env_get() {
  local key=$1 file=${2:-$ENV_FILE} line val
  [[ -f "$file" ]] || return 0
  line=$(grep -E "^[[:space:]]*${key}=" "$file" | tail -n 1 || true)
  [[ -z "$line" ]] && return 0
  val=${line#*=}
  val=${val%$'\r'}
  if [[ "$val" =~ ^\'(.*)\'$ ]]; then val=${BASH_REMATCH[1]}
  elif [[ "$val" =~ ^\"(.*)\"$ ]]; then val=${BASH_REMATCH[1]}
  fi
  printf '%s' "$val"
}

env_line() {
  local key=$1 val=$2
  if [[ "$val" =~ ^[A-Za-z0-9_./:@,+=-]*$ ]]; then
    printf '%s=%s' "$key" "$val"
  else
    printf "%s='%s'" "$key" "$val"
  fi
}

# Define KEY=valor no .env (substitui a linha existente ou adiciona no fim)
env_set() {
  local key=$1 val=$2 tmp newline
  [[ "$val" != *"'"* && "$val" != *$'\n'* ]] || die "O valor de ${key} não pode conter aspas simples nem quebras de linha."
  newline=$(env_line "$key" "$val")
  tmp=$(mktemp "$ATENDIA_DIR/.env.XXXXXX")
  NEWLINE="$newline" awk -v key="$key" '
    BEGIN { done = 0 }
    $0 ~ "^[[:space:]]*" key "=" { if (!done) { print ENVIRON["NEWLINE"]; done = 1 }; next }
    { print }
    END { if (!done) print ENVIRON["NEWLINE"] }
  ' "$ENV_FILE" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$ENV_FILE"
}

backup_env() {
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  cp -p "$ENV_FILE" "$BACKUP_DIR/env-$(date +%Y%m%d-%H%M%S).bak"
}

public_url() { env_get PUBLIC_URL; }

valid_email()  { [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; }
valid_ipv4()   { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
password_ok()  { [[ ${#1} -ge 8 && "$1" =~ [A-Z] && "$1" =~ [a-z] && "$1" =~ [0-9] && "$1" != *"'"* ]]; }

# Regras ESTRITAS — iguais às do backend (packages/backend/src/services/domain.service.ts).
# Domínio: minúsculo, rótulos [a-z0-9-] sem hífen nas pontas, TLD só letras (>= 2),
# total <= 253. Recusa IP, localhost, espaços e qualquer caractere de shell.
valid_domain_strict() {
  local LC_ALL=C d=${1:-}
  (( ${#d} >= 4 && ${#d} <= 253 )) || return 1
  [[ "$d" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || return 1
  case "${d##*.}" in
    localhost|local|internal|invalid|test|example|lan|home|corp) return 1 ;;
  esac
  return 0
}
valid_email_strict() {
  local LC_ALL=C e=${1:-}
  (( ${#e} >= 6 && ${#e} <= 254 )) || return 1
  [[ "$e" =~ ^[A-Za-z0-9._+-]+@([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]
}

# "HTTPS://Loja.DuckDNS.org/" -> "loja.duckdns.org" (espaço no meio continua inválido)
normalize_domain() {
  local d
  d=$(printf '%s' "${1:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
  d=${d#http://}; d=${d#https://}
  while [[ "$d" == */ ]]; do d=${d%/}; done
  d=${d%.}
  printf '%s' "$d"
}

gen_password() {
  local p
  while :; do
    p=$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-16)
    if [[ ${#p} -eq 16 && "$p" =~ [A-Z] && "$p" =~ [a-z] && "$p" =~ [0-9] ]]; then
      printf '%s' "$p"; return 0
    fi
  done
}

detect_public_ip() {
  local ip src
  ip=$(curl -fsS -m 3 -H 'Metadata-Flavor: Google' \
    http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip 2>/dev/null || true)
  if ! valid_ipv4 "${ip:-x}"; then
    for src in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
      ip=$(curl -4 -fsS -m 5 "$src" 2>/dev/null | tr -d '[:space:]' || true)
      valid_ipv4 "${ip:-x}" && break
      ip=""
    done
  fi
  [[ -n "$ip" ]] || ip=$(env_get ATENDIA_PUBLIC_IP)
  printf '%s' "$ip"
}

backend_health() {
  local cid
  cid=$(compose ps -q backend 2>/dev/null || true)
  [[ -n "$cid" ]] || { echo "parado"; return; }
  docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || echo "parado"
}

wait_healthy() {
  local limit=${1:-240} start elapsed status
  start=$(date +%s)
  while :; do
    status=$(backend_health)
    if [[ "$status" == healthy ]]; then ok "Sistema no ar (health OK)."; return 0; fi
    elapsed=$(( $(date +%s) - start ))
    if (( elapsed >= limit )); then
      fail "O sistema não ficou pronto em ${limit}s (estado: ${status}). Últimas linhas do log:"
      compose logs --tail=40 backend 2>&1 | sed 's/^/    /' || true
      return 1
    fi
    if [[ "$HAS_TTY" == 1 ]]; then printf '\r  Aguardando o sistema iniciar... %ss (%s)   ' "$elapsed" "$status" >/dev/tty; fi
    sleep 3
  done
}

update_cred_file() {
  # update_cred_file CAMPO VALOR   (Endereço / E-mail / Senha)
  local field=$1 value=$2 tmp
  umask 077
  if [[ ! -f "$CRED_FILE" ]]; then
    printf 'AtendIA — dados de acesso\n\nEndereço: %s\nE-mail: %s\nSenha: \n' "$(public_url)" "$(env_get ATENDIA_ADMIN_EMAIL)" > "$CRED_FILE"
  fi
  tmp=$(mktemp)
  FIELD="$field" VALUE="$value" awk '
    BEGIN { f = ENVIRON["FIELD"]; v = ENVIRON["VALUE"]; done = 0 }
    index($0, f ":") == 1 { print f ": " v; done = 1; next }
    { print }
    END { if (!done) print f ": " v }
  ' "$CRED_FILE" > "$tmp"
  mv -f "$tmp" "$CRED_FILE"
  chmod 600 "$CRED_FILE"
}

