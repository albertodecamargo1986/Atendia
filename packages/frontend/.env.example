# Endereço da API. Deixe vazio para usar /api no mesmo domínio (recomendado).
VITE_API_URL=
# Endereço do Socket.IO. Deixe vazio para usar o mesmo domínio do site.
VITE_WS_URL=
# Só no desenvolvimento (npm run dev): para onde o Vite encaminha /api, /socket.io,
# /uploads e /health. Padrão: http://localhost:3001
# Atenção: o vite.config.ts lê do ambiente do terminal (process.env), não deste arquivo.
# Ex.: VITE_DEV_BACKEND=http://172.20.0.2:3001 npm run dev -w frontend
# VITE_DEV_BACKEND=
