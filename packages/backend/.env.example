# AtendIA Backend — variáveis de ambiente (desenvolvimento local)
# Em produção o instalador (install/install.sh) gera o .env da raiz automaticamente.

# ── Ambiente ──
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ── URL pública ──
# Endereço pelo qual as pessoas acessam o sistema (ex.: http://34.1.2.3 ou https://atendia.duckdns.org).
# Se vazio, usa os valores de desenvolvimento abaixo.
# Derivados automaticamente quando não informados:
#   FRONTEND_URL = PUBLIC_URL, ALLOWED_ORIGINS = PUBLIC_URL, API_URL = PUBLIC_URL/api
#   COOKIE_SECURE = true só se PUBLIC_URL começar com https
PUBLIC_URL=
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001/api
# Lista separada por vírgulas
ALLOWED_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false
# Atrás de proxy reverso (Caddy/nginx): 1
TRUST_PROXY=

# ── Banco de dados e Redis (obrigatórios) ──
DATABASE_URL=postgresql://atend:atend@localhost:5432/atend_ia
REDIS_URL=redis://localhost:6379

# ── Segredos (obrigatórios) — gere com: openssl rand -hex 32 ──
JWT_SECRET=
JWT_REFRESH_SECRET=
# 64 caracteres hexadecimais: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# ── Pastas de dados ──
UPLOAD_DIR=./uploads
WHATSAPP_AUTH_DIR=./whatsapp-auth
MAX_FILE_SIZE=10485760

# ── IA (opcional — cada empresa também pode cadastrar a própria chave no painel) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ── E-mail / SMTP (opcional — sem SMTP os e-mails aparecem no log) ──
SMTP_HOST=
SMTP_PORT=587
# true para porta 465 (SSL); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AtendIA <noreply@atend-ia.com>"

# ── Pagamentos (opcional) ──
MP_ACCESS_TOKEN=
# Obrigatório em produção para aceitar webhooks do Mercado Pago
MP_WEBHOOK_SECRET=
MP_SANDBOX=false
MP_SANDBOX_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Administrador da plataforma (usado por `npm run db:seed` e dist/scripts/create-admin.js) ──
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador
# COMPANY_NAME=Minha Empresa
